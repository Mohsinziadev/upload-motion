{
  "name": "upload-motion-monorepo",
  "private": true,
  "description": "Monorepo for upload-motion: animated, accessible file uploads for React.",
  "license": "MIT",
  "packageManager": "npm@11.21.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/react",
    "apps/docs"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:lib": "npm run build -w upload-motion",
    "dev": "turbo run dev --filter=docs...",
    "test": "turbo run test",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "size": "npm run size -w upload-motion"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "turbo": "^2.11.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
